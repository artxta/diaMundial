{
  "name": "dia-mundial",
  "private": true,
  "version": "14.0.0",
  "packageManager": "pnpm@11.23.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "postinstall": "node -e \"const fs=require('fs');const g='node_modules/@capacitor-community/sqlite/android/build.gradle';if(fs.existsSync(g)){let c=fs.readFileSync(g,'utf8');if(c.includes('proguard-android.txt')&&!c.includes('proguard-android-optimize.txt')){fs.writeFileSync(g,c.replace('proguard-android.txt','proguard-android-optimize.txt'));console.log('Patched proguard-android.txt in @capacitor-community/sqlite')}}\""
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.0",
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/status-bar": "^7.0.6",
    "@ionic/react": "^8.5.0",
    "@ionic/react-router": "^8.5.0",
    "ionicons": "^7.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.8.2",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
